# Which chat provider to use: "ollama" (local, free) or "openai"
LLM_PROVIDER=ollama

# Ollama (install from https://ollama.com, then: ollama pull llama3.2:3b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
