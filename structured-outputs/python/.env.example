# Which provider to use: "groq" (default; free tier, hosted) or "ollama" (local)
LLM_PROVIDER=groq

# Groq: create a free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ollama (only when LLM_PROVIDER=ollama): install from https://ollama.com,
# then: ollama pull llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
