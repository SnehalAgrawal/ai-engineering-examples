# Which model serves the conversations: "ollama" (local, default) or "groq" (hosted free tier).
LLM_PROVIDER=ollama

# Ollama (https://ollama.com): ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b

# Groq (https://console.groq.com): free API key. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
