# Local Ollama server (https://ollama.com). This demo measures local inference, so there is no hosted option.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
# Where Ollama writes its server log (macOS default). kv_cache.py reads it to compare with its prediction.
OLLAMA_LOG=~/.ollama/logs/server.log
