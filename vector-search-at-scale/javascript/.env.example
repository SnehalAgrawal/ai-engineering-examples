# Copy this file to .env and choose a provider for building the embedding corpus: "ollama" or "openai"
EMBEDDING_PROVIDER=ollama

# Ollama (local, free; recommended for this demo because it embeds ~236,000 items)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI (cloud; embedding the full word list costs money, so consider --limit)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
