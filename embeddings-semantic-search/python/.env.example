# Copy this file to .env and choose a provider: "openai" or "ollama"
EMBEDDING_PROVIDER=openai

# OpenAI (cloud)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional task prefixes. Some models are trained to expect different prefixes
# for queries and documents. nomic-embed-text, for example, uses:
# QUERY_PREFIX="search_query: "
# DOCUMENT_PREFIX="search_document: "
QUERY_PREFIX=
DOCUMENT_PREFIX=
